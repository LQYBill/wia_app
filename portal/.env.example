NODE_ENV=development
DATA_MODE=demo
API_HOST=127.0.0.1
API_PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
CURRENCY=EUR
# Real database mode is read-only. A SELECT-only database account is recommended.
# DATA_MODE=mysql_readonly
# CLIENT_ID=existing-client-id
# MYSQL_HOST=192.168.1.10
# MYSQL_PORT=3306
# MYSQL_DATABASE=existing-database
# MYSQL_USER=portal_readonly
# MYSQL_PASSWORD=
# MYSQL_SSL=false
NAS_ROOT=./.runtime/files
# Required for production:
# SESSION_SECRET=generate-a-random-secret-at-least-32-characters
# REDIS_URL=redis://redis:6379
# BOOTSTRAP_EMAIL=your-account@example.com
# BOOTSTRAP_PASSWORD_HASH=generated-with-npm-run-password:hash
